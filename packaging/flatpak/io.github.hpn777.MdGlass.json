{
  "id": "io.github.hpn777.MdGlass",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "mdglass-gui",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "mdglass",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/mdglass/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo build --release --offline --locked",
        "install -Dm755 target/release/mdglass packaging/flatpak/mdglass-gui -t /app/bin",
        "install -Dm644 packaging/io.github.hpn777.MdGlass.desktop -t /app/share/applications",
        "install -Dm644 packaging/io.github.hpn777.MdGlass.svg -t /app/share/icons/hicolor/scalable/apps",
        "install -Dm644 packaging/io.github.hpn777.MdGlass.metainfo.xml -t /app/share/metainfo"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": ["dist", ".flatpak-builder", "repo", "target"]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
